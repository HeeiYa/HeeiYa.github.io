---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('archive'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Archive — Hanyang Zhang" description="Past projects and writing by Hanyang Zhang">
  <p class="eyebrow">Archive</p>
  <h1>过去完成的工作。</h1>
  <p class="lead archive-intro">
    这里保存已经结束、但仍值得公开查阅的项目记录。第一批内容来自我在 2024 年参与 OSPP、为 KDE 移植 Android 游戏期间写下的英文博客。
  </p>

  <h2>2024 OSPP · KDE</h2>
  {posts.map((post) => (
    <a class="post-card" href={`/archive/${post.id}/`}>
      <strong>{post.data.title}</strong>
      <p>{post.data.description}</p>
      <span class="post-meta">
        <time datetime={post.data.publishedAt.toISOString()}>
          {post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>
        <span>{post.data.tags.join(' · ')}</span>
      </span>
    </a>
  ))}
</BaseLayout>
