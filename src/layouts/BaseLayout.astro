---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'HeeiYa 的个人博客与项目归档',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✦</text></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">HeeiYa</a>
      <nav aria-label="主要导航">
        <a href="/#posts">Blog</a>
        <a href="https://github.com/HeeiYa">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} HeeiYa</footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #20231f;
    background: #f6f5ef;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
  }

  header,
  main,
  footer {
    width: min(760px, calc(100% - 40px));
    margin-inline: auto;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 0;
    border-bottom: 1px solid #d9d8d0;
  }

  .brand {
    color: inherit;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  nav { display: flex; gap: 20px; }
  nav a, article a { color: #365f4b; }

  main { padding: 72px 0 96px; }

  h1, h2 {
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  h1 { margin: 0 0 20px; font-size: clamp(2.8rem, 9vw, 5.5rem); }
  h2 { margin-top: 64px; font-size: 1.7rem; }

  p, li {
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .eyebrow {
    margin-bottom: 18px;
    color: #667064;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .lead {
    max-width: 640px;
    color: #555b53;
    font-size: clamp(1.2rem, 3vw, 1.45rem);
  }

  .post-card {
    display: block;
    margin-top: 24px;
    padding: 24px 0;
    border-top: 1px solid #d9d8d0;
    color: inherit;
    text-decoration: none;
  }

  .post-card strong { font-size: 1.25rem; }
  .post-card p { margin: 8px 0 0; color: #667064; }

  article img {
    max-width: 100%;
    height: auto;
  }

  article video {
    display: block;
    width: 100%;
    height: auto;
    margin: 28px 0;
    background: #111;
  }

  article pre {
    overflow-x: auto;
    padding: 18px;
    border-radius: 6px;
    background: #20231f;
    color: #f6f5ef;
  }

  article { max-width: 680px; }
  article h1 { font-size: clamp(2.4rem, 8vw, 4.4rem); }
  article .meta { color: #667064; }

  footer {
    padding: 24px 0 40px;
    border-top: 1px solid #d9d8d0;
    color: #737970;
    font-size: .85rem;
  }

  @media (max-width: 560px) {
    header { align-items: flex-start; gap: 20px; }
    nav { gap: 12px; font-size: .9rem; }
    main { padding-top: 52px; }
  }
</style>
